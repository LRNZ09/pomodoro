{
	"name": "@beautifoo/pi-pomodoro",
	"version": "0.0.0",
	"description": "Pomodoro for Pi: a break when your 25 minutes are up, and a check-in where the agent sums up.",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"author": "Lorenzo Pieri",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LRNZ09/pomodoro.git",
		"directory": "packages/pi"
	},
	"type": "module",
	"files": [
		"index.ts",
		"core.ts"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"build": "cp ../../lib/core/index.ts core.ts",
		"prepack": "npm run build"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@types/node": "26.6.5"
	}
}
