{
	"name": "pomodoro",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "bun run --filter @beautifoo/claude-pomodoro build",
		"check": "biome check",
		"eval": "bun run build && bun scripts/eval.ts",
		"fix": "biome check --write",
		"test": "bun run build && bun test packages/core && claude plugin test packages/claude",
		"typecheck": "bun run build && tsc -p packages/claude && tsc -p ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@lrnz09/biome-config": "1.2.0",
		"@types/bun": "1.3.14",
		"typescript": "5.6.3"
	}
}
